<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@username" />
<meta name="twitter:creator" content="@username" />
<meta name="twitter:title" content="{literal}{product_name}{/literal}" />
<meta name="twitter:description" content="{literal}{short_description|nohtml}{/literal}" />
<meta name="twitter:image" content="{literal}{cover_image_link}{/literal}" />