# Khewa PS 9.2: error logs of the module. Never run scripts here.

# Apache 2.2
<IfModule !mod_authz_core.c>
   <FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh|asp|aspx|jsp|shtml|htaccess|htpasswd|ini)(\.|$)">
   order allow,deny
   deny from all
   </FilesMatch>
</IfModule>

# Apache 2.4
<IfModule mod_authz_core.c>
   <FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh|asp|aspx|jsp|shtml|htaccess|htpasswd|ini)(\.|$)">
   Require all denied
   </FilesMatch>
</IfModule>
